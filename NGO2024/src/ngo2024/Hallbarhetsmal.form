                <Column editable="true" title="Namn" type="java.lang.Object">
                  <Data value="Inga fattiga"/>
                  <Data value="Noll hunger"/>
                  <Data value="God h&#xe4;lsa och v&#xe4;lbefinnande"/>
                  <Data value="H&#xe5;llbart jordbruk"/>
                  <Data value="J&#xe4;mst&#xe4;lldhet"/>
                  <Data value="Rent vatten och sanitet"/>
                  <Data value="F&#xf6;rnybar energi"/>
                  <Data value="Anst&#xe4;ndiga arbetsvillkor"/>
                  <Data value="Innovation och infrastruktur"/>
                  <Data value="Minskad oj&#xe4;mlikhet"/>
                  <Data value="H&#xe5;llbara st&#xe4;der och samh&#xe4;llen"/>
                  <Data value="H&#xe5;llbara konsumtions- och produktionsm&#xf6;nster"/>
                  <Data value="Bek&#xe4;mpa klimatf&#xf6;r&#xe4;ndringarna"/>
                  <Data value="Hav och marina resurser"/>
                  <Data value="Livet p&#xe5; land"/>
                  <Data value="Fredliga och inkluderande samh&#xe4;llen"/>
                  <Data value="Samverkan och genomf&#xf6;randen"/>
                </Column>
                <Column editable="true" title="Beskrivning" type="java.lang.Object">
                  <Data value="Uppn&#xe5; noll hunger och utrota all form av fattigdom &#xf6;ver hela v&#xe4;rlden"/>
                  <Data value="S&#xe4;kerst&#xe4;ll h&#xe5;llbar matproduktionssystem och fr&#xe4;mja jordbruket f&#xf6;r att uppn&#xe5; n&#xe4;ringsriktig kost f&#xf6;r alla"/>
                  <Data value="S&#xe4;kerst&#xe4;ll h&#xe4;lsosamt liv och fr&#xe4;mja v&#xe4;lbefinnande f&#xf6;r alla i alla &#xe5;ldrar"/>
                  <Data value="S&#xe4;kerst&#xe4;ll h&#xe5;llbar matproduktion och fr&#xe4;mja h&#xe5;llbart jordbruk"/>
                  <Data value="Uppn&#xe5; j&#xe4;mst&#xe4;lldhet och st&#xe4;rka alla kvinnor och flickor"/>
                  <Data value="S&#xe4;kerst&#xe4;ll tillg&#xe5;ng till rent vatten och sanitet f&#xf6;r alla"/>
                  <Data value="S&#xe4;kerst&#xe4;ll tillg&#xe5;ng till p&#xe5;litlig, h&#xe5;llbar och modern energi f&#xf6;r alla"/>
                  <Data value="Fr&#xe4;mja varaktig, inkluderande och h&#xe5;llbar ekonomisk tillv&#xe4;xt, full och produktiv syssels&#xe4;ttning och anst&#xe4;ndigt arbete f&#xf6;r alla"/>
                  <Data value="Bygga robust infrastruktur, fr&#xe4;mja inkluderande och h&#xe5;llbar industrialisering och &#xf6;ka innovation"/>
                  <Data value="Minska oj&#xe4;mlikhet inom och mellan l&#xe4;nder"/>
                  <Data value="G&#xf6;ra st&#xe4;der och m&#xe4;nskliga bos&#xe4;ttningar inkluderande, s&#xe4;kra, motst&#xe5;ndskraftiga och h&#xe5;llbara"/>
                  <Data value="S&#xe4;kerst&#xe4;lla h&#xe5;llbara konsumtions- och produktionsm&#xf6;nster"/>
                  <Data value="Vidta omedelbara &#xe5;tg&#xe4;rder f&#xf6;r att bek&#xe4;mpa klimatf&#xf6;r&#xe4;ndringarna och dess p&#xe5;verkan"/>
                  <Data value="Bevara och h&#xe5;llbart nyttja haven, haven och marina resurser f&#xf6;r h&#xe5;llbar utveckling"/>
                  <Data value="Skydda, &#xe5;terst&#xe4;lla och fr&#xe4;mja h&#xe5;llbar anv&#xe4;ndning av ekosystem, h&#xe5;llbart skogsbruk, bek&#xe4;mpa &#xf6;kenspridning, stoppa och v&#xe4;nda markdegradering och f&#xf6;rlust av biologisk m&#xe5;ngfald"/>
                  <Data value="Fr&#xe4;mja fredliga och inkluderande samh&#xe4;llen f&#xf6;r h&#xe5;llbar utveckling, ge tillg&#xe5;ng till r&#xe4;ttvisa f&#xf6;r alla och bygga effektiva, ansvariga och inkluderande institutioner p&#xe5; alla niv&#xe5;er"/>
                  <Data value="St&#xe4;rka genomf&#xf6;randemedlen och revitalisera den globala partnerskapet f&#xf6;r h&#xe5;llbar utveckling"/>
                </Column>
